(version 1)

# T24-10  2-layer standard  -  custom design rules, generated by tools/make_tile_templates.py

# Tile base pads are the SMD pads on B.Cu. They reach the board edge by design,
# so they are exempt from the 0.15 mm copper-to-edge clearance in Board Setup.
# (A pad flush with the edge measures 0, which KiCad treats as a violation of
# 'min 0', hence the small negative minimum.)
(rule "tile base pads reach the board edge"
	(condition "A.Pad_Type == 'SMD' && A.existsOnLayer('B.Cu')")
	(constraint edge_clearance (min -0.1mm)))

# Components live on the top side only; the bottom carries the base pads and
# the tile name. Anything else on B.Cu is a mistake.
(rule "no components on the bottom side"
	(condition "A.Type == 'Footprint' && A.Layer == 'B.Cu' && !(A.Reference =~ '^P[0-9]+$')")
	(constraint disallow footprint))

# Blind/buried vias are not part of any ordered stackup.
(rule "no blind or buried vias"
	(constraint disallow buried_via))

# This tier is quoted without laser drilling.
(rule "no microvias on this tier"
	(constraint disallow micro_via))

# --- your own rules below this line ---
# Rules below this line survive tools/set_tier.py; everything above is regenerated.
